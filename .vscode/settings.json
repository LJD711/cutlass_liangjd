{
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/tools/util/include",
    "${workspaceFolder}/tools/library/include",
    "${workspaceFolder}/tools/profiler/include",
    "${workspaceFolder}/examples",
    "${workspaceFolder}/test",
    "${workspaceFolder}/operators",
    "${workspaceFolder}/cutlass_compiler/base/include",
    "${workspaceFolder}/cutlass_compiler/cutegen/include",
    "${workspaceFolder}/cutlass_compiler/cute_ir/include"
  ],
  "C_Cpp.default.browse.path": [
    "${workspaceFolder}"
  ],
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.intelliSenseEngine": "Tag Parser",
